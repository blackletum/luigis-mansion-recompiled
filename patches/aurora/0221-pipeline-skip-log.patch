     const auto it = g_pipelines.find(ref);
     if (it != g_pipelines.end()) {
-      if (!it->second.main) {
-        ++g_droppedDraws; // creation failed
-        return false;
+      if (it->second.main) {
+        pipeline = it->second;
+        return true;
       }
-      pipeline = it->second;
-      return true;
+      failed = true;
     }
   }
+  if (failed) {
+    note_skipped_draw(ref, what, "creation failed"); // (takes g_pipelineMutex itself)
+    return false;
+  }
