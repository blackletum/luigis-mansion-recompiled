-    ++g_droppedDraws;
+    note_skipped_draw(ref, what, "not built yet (waiting off)");
     return false;
   }
   if (!wait_for_pending_pipeline(ref, pipeline)) {
-    ++g_droppedDraws;
+    note_skipped_draw(ref, what, "not built and not queued, or creation failed");
     return false;
   }
