+// AURORA_DRAW_STOP=<n>: in the logged frames, draws from ordinal n on are dropped and EFB copies
+// no longer clear, so the displayed frame shows the EFB as it was after draw n-1.
+// AURORA_DRAW_STOP=copy: stop at the frame's first full-size (640x480) copy instead.
+static bool sDbgStopHit = false;
+bool draw_debug_stopped(u32 idx) noexcept {
+  static const u32 sStop = [] {
+    const char* p = std::getenv("AURORA_DRAW_STOP");
+    if (p != nullptr && std::strcmp(p, "copy") == 0) {
+      return UINT32_MAX - 1;
+    }
+    if (p == nullptr && std::getenv("AURORA_DRAW_STOP_MATCH") != nullptr) {
+      return UINT32_MAX - 1;
+    }
+    return p ? static_cast<u32>(std::strtoul(p, nullptr, 10)) : UINT32_MAX;
+  }();
+  if (sStop == UINT32_MAX) {
+    return false;
+  }
+  const auto& dbg = draw_debug();
+  const u32 frame = sDbgFrame.load(std::memory_order_relaxed);
+  if (frame < dbg.first || frame > dbg.last) {
+    return false;
+  }
+  return sStop == UINT32_MAX - 1 ? sDbgStopHit : idx >= sStop;
+}
