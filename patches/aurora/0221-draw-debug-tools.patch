+static void draw_debug_vertices(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, const u8* vtx, u32 vtxSize) noexcept {
+  const auto& dbg = draw_debug();
+  const u32 frame = sDbgFrame.load(std::memory_order_relaxed);
