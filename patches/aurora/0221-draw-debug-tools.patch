+  const auto& P = g_gxState.proj;
+  const u32 n = std::min<u32>(vtxCount, 64u);
+  for (u32 v = 0; v < n; ++v) {
+    float p[3];
+    u32 mi = 0;
+    if (!probe_vertex(fmt, vtx + v * vtxSize, p, mi)) {
+      continue;
+    }
+    if (mi >= MaxPnMtx) {
+      mi = 0;
+    }
+    const auto& M = g_gxState.pnMtx[mi].pos;
